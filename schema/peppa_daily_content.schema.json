{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "peppa_daily_content.schema.json",
  "title": "小猪佩奇 · 每日亲子内容 Episode Content Schema",
  "type": "object",
  "required": ["version", "episodes"],
  "properties": {
    "version": {
      "type": "string",
      "description": "schema 版本号，格式 semver。破坏性改动必须升 major。"
    },
    "meta": {
      "type": "object",
      "description": "整本内容集的元信息",
      "properties": {
        "title": {"type": "string"},
        "total_days": {"type": "integer", "minimum": 1},
        "start_date": {"type": "string", "format": "date"},
        "generator": {"type": "string"},
        "source": {
          "type": "object",
          "description": "数据来源与可追溯性",
          "properties": {
            "episode_list": {"type": "string", "description": "剧集清单来源，如 B站12季核实表"},
            "plot_source": {"type": "string", "description": "剧情摘要来源，如 TVMaze / TMDB / LLM"},
            "confidence": {"type": "string", "enum": ["high", "medium", "low"], "description": "整体可信度"}
          },
          "required": ["episode_list", "plot_source", "confidence"]
        },
        "calibration": {
          "type": "object",
          "description": "内容生成参数记录，用于批量重跑时复现",
          "properties": {
            "difficulty_curve": {"type": "array", "items": {"type": "object"}},
            "day_types": {"type": "array", "items": {"type": "string"}},
            "avoid_repeat_window": {"type": "integer", "description": "防重复滑动窗口天数"}
          }
        }
      }
    },
    "episodes": {
      "type": "array",
      "items": {"$ref": "#/$defs/episode"}
    }
  },

  "$defs": {
    "episode": {
      "type": "object",
      "required": ["ep", "day", "title", "day_type", "difficulty", "content"],
      "properties": {
        "ep": {
          "type": "string",
          "pattern": "^[0-9]+-[0-9]{2}$",
          "description": "集号，格式 season-episode，如 1-01、9-40"
        },
        "day": {"type": "integer", "minimum": 1, "description": "第几天，从 1 起连续"},
        "date": {"type": "string", "format": "date", "description": "对应日期，由 day + start_date 推导"},
        "title": {"$ref": "#/$defs/title"},
        "day_type": {
          "type": "string",
          "enum": ["新剧日", "台词日", "单词日", "动手日", "创作日", "家庭日", "复习日", "主题周", "里程碑日", "反转日", "无屏幕日"],
          "description": "当日玩法类型，决定卡片强调哪个区块"
        },
        "difficulty": {"type": "string", "enum": ["简单", "中等", "挑战"]},
        "airdate": {"type": ["string", "null"], "format": "date", "description": "该集首播日期"},
        "tags": {
          "type": "object",
          "description": "检索与关联标签",
          "properties": {
            "season_context": {"type": "string", "description": "如 二胎、看牙、圣诞节"},
            "life_scenario": {"type": "string", "description": "对应育儿场景，如 分离焦虑、输不起"}
          }
        },
        "content": {"$ref": "#/$defs/content"},
        "quality": {"$ref": "#/$defs/quality"}
      }
    },

    "title": {
      "type": "object",
      "required": ["zh", "en"],
      "properties": {
        "zh": {"type": "string", "description": "中文剧名，取自核实表"},
        "en": {"type": "string", "description": "英文剧名"},
        "zh_alt": {"type": "array", "items": {"type": "string"}, "description": "同义译名，检索用"}
      }
    },

    "content": {
      "type": "object",
      "required": ["plot", "core", "beats", "words", "lines", "ask", "play", "checkin"],
      "properties": {
        "plot": {"$ref": "#/$defs/plot"},
        "core": {"$ref": "#/$defs/core"},
        "concepts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {"type": "string"},
          "description": "概念标签，2-4 字，如 天气 / 安全规则 / 家庭互动"
        },
        "beats": {"type": "array", "items": {"$ref": "#/$defs/beat"}, "minItems": 3, "maxItems": 6},
        "roles": {"type": "array", "items": {"$ref": "#/$defs/role"}, "maxItems": 5},
        "words": {"type": "array", "items": {"$ref": "#/$defs/word"}, "minItems": 3, "maxItems": 6},
        "lines": {"type": "array", "items": {"$ref": "#/$defs/line"}, "minItems": 1, "maxItems": 3},
        "ask": {"type": "array", "items": {"$ref": "#/$defs/ask"}, "minItems": 2, "maxItems": 4},
        "play": {"$ref": "#/$defs/play"},
        "tips": {"type": "array", "items": {"$ref": "#/$defs/tip"}, "maxItems": 4},
        "quiz": {"type": "array", "items": {"$ref": "#/$defs/quiz"}, "maxItems": 4},
        "review": {"$ref": "#/$defs/review"}
      }
    },

    "plot": {
      "type": "object",
      "required": ["summary", "source"],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 30, "maxLength": 160,
          "description": "中文剧情，2-3 句，80 字以内为宜。只写发生了什么，不写评价。"
        },
        "source": {"type": "string", "enum": ["tvmaze", "tmdb", "bilibili_subtitle", "llm"], "description": "该剧情的来源，便于追溯与补全"},
        "source_en": {"type": "string", "description": "英文原始摘要（若有）"},
        "confidence": {"type": "string", "enum": ["high", "medium", "low"]}
      }
    },

    "core": {
      "type": "object",
      "required": ["lesson", "keywords"],
      "properties": {
        "lesson": {
          "type": "string",
          "maxLength": 40,
          "description": "本集核心道理，一句话，可独立成立。不要写成『这集告诉我们…』"
        },
        "keywords": {
          "type": "array",
          "items": {"type": "string"},
          "minItems": 2, "maxItems": 4,
          "description": "价值词，2-6 字。如 分享 / 坚持 / 道歉 / 耐心"
        },
        "emotion": {
          "type": "string",
          "enum": ["快乐", "难过", "生气", "害怕", "骄傲", "感动", "平静", "紧张", "失落"],
          "description": "本集主情绪，用于选表情与配图"
        }
      }
    },

    "beat": {
      "type": "object",
      "required": ["stage", "desc", "en"],
      "properties": {
        "stage": {
          "type": "string",
          "enum": ["开场", "铺垫", "转折", "小冲突", "高潮", "解决", "结尾"],
          "description": "叙事节拍类型"
        },
        "desc": {"type": "string", "maxLength": 40, "description": "这一拍发生了什么"},
        "en": {"type": "string", "description": "对应的英文原句，若无则留空"},
        "graphic": {
          "type": "string",
          "description": "插画提示词关键词，指向 kid_motifs 中的图元，如 puddle / parrot / snow"
        }
      }
    },

    "role": {
      "type": "object",
      "required": ["who", "emotion_path", "learned"],
      "properties": {
        "who": {"type": "string", "description": "角色名：佩奇/乔治/猪妈妈/猪爸爸/苏西/朋友角色名"},
        "emotion_path": {"type": "string", "description": "情绪变化，用箭头连接，如 无聊 → 兴奋 → 不甘 → 开心"},
        "learned": {"type": "string", "maxLength": 30, "description": "这集里这个角色学到了什么"},
        "say": {"type": "string", "description": "本集该角色的代表性台词（英文）"}
      }
    },

    "word": {
      "type": "object",
      "required": ["en", "ipa", "zh", "level"],
      "properties": {
        "en": {"type": "string", "description": "英文单词"},
        "ipa": {"type": "string", "description": "音标，带斜杠"},
        "zh": {"type": "string", "description": "中文释义"},
        "level": {"type": "integer", "minimum": 1, "maximum": 3, "description": "难度级，1 最易"},
        "pos": {"type": "string", "enum": ["n", "v", "adj", "adv", "num", "phrase"]},
        "example": {"type": "string", "description": "本集原句例句，必须来自该集"},
        "graphic": {"type": "string", "description": "对应图元 key，用于词卡配图"},
        "is_new": {"type": "boolean", "description": "是否为首次出现（复习日用于排期）"}
      }
    },

    "line": {
      "type": "object",
      "required": ["en", "zh"],
      "properties": {
        "en": {"type": "string", "description": "英文台词"},
        "zh": {"type": "string", "description": "中文对照"},
        "why": {"type": "string", "maxLength": 50, "description": "为什么值得学：句型/语法点/文化点"},
        "grammar": {"type": "string", "description": "语法点标签，如 must+动词原形 / 过去式"},
        "repeat": {"type": "boolean", "description": "是否适合反复跟读"}
      }
    },

    "ask": {
      "type": "object",
      "required": ["type", "q"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["回忆", "联系生活", "想象", "情绪", "判断", "预测"],
          "description": "问题类型，决定卡片标签色"
        },
        "q": {"type": "string", "maxLength": 40, "description": "问题本身，必须咬合本集剧情"},
        "expect": {"type": "string", "description": "参考回答要点，给不确定的家长兜底"},
        "zh": {"type": "boolean", "description": "是否需要中文作答"}
      }
    },

    "play": {
      "type": "object",
      "required": ["activity", "duration_min"],
      "properties": {
        "activity": {"type": "string", "maxLength": 80, "description": "怎么玩，必须用家里现成东西"},
        "duration_min": {"type": "integer", "minimum": 1, "maximum": 20},
        "materials": {"type": "array", "items": {"type": "string"}, "description": "需要准备的材料"},
        "indoor": {"type": "boolean", "description": "是否适合室内/雨天"},
        "lang_en": {"type": "string", "description": "活动中要说的英文句型"}
      }
    },

    "tip": {
      "type": "object",
      "required": ["kind", "text"],
      "properties": {
        "kind": {"type": "string", "enum": ["发音", "文化", "育儿", "安全"]},
        "text": {"type": "string", "maxLength": 60}
      }
    },

    "quiz": {
      "type": "object",
      "required": ["q", "options", "answer"],
      "properties": {
        "q": {"type": "string", "maxLength": 30},
        "options": {"type": "array", "items": {"type": "string"}, "minItems": 2, "maxItems": 3},
        "answer": {"type": "integer", "minimum": 0, "description": "正确选项下标"},
        "kind": {"type": "string", "enum": ["词汇", "剧情", "常识", "判断"]}
      }
    },

    "review": {
      "type": "object",
      "description": "间隔复习排期，由 FSRS 类算法或固定间隔生成",
      "properties": {
        "review_days": {
          "type": "array", "items": {"type": "integer"},
          "description": "需要复习的相对天数，如 [1, 3, 7, 21] 表示第2/4/8/22天回看"
        },
        "recall_prompt": {"type": "string", "description": "复习时的提示问题"},
        "links_to": {"type": "array", "items": {"type": "string"}, "description": "关联的往期集号，形成复习网络"}
      }
    },

    "quality": {
      "type": "object",
      "description": "自检结果，批量生成后自动跑，低于阈值的返工",
      "properties": {
        "word_count_ok": {"type": "boolean", "description": "单词数是否达下限"},
        "line_from_episode": {"type": "boolean", "description": "金句是否确为该集原句"},
        "no_repeat_30d": {"type": "boolean", "description": "与前30天是否有重复问题/玩法"},
        "difficulty_match": {"type": "boolean"},
        "issues": {"type": "array", "items": {"type": "string"}, "description": "发现的问题清单"}
      }
    }
  }
}